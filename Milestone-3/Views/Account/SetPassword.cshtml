@model CampusX.ViewModel.SetPasswordViewModel
@{
    ViewData["Title"] = "Set password";
    var verification = Model.Verification;
    var sendLabel = verification.HasActiveCode ? "Resend code" : "Send code";
}

<section class="login-panel" aria-labelledby="set-password-title">
    <div class="login-card verification-card">
        <h1 id="set-password-title">Set password</h1>
        <p>Confirm access to your verified university inbox to add a CampusX password. You can still sign in with Google.</p>

        @if (TempData["PasswordSetupMessage"] is string message)
        {
            <p class="account-success" role="status">@message</p>
        }
        <div asp-validation-summary="ModelOnly" class="login-error validation-summary" role="alert"></div>

        <div class="verification-address">
            <span>Verified Cairo University email</span>
            <strong>@verification.MaskedEmail</strong>
        </div>

        @if (verification.Notice is not null)
        {
            <p class="field-help" role="status">@verification.Notice</p>
        }

        @if (verification.HasActiveCode)
        {
            <form asp-action="SetPassword" method="post">
                <div class="login-field">
                    <label asp-for="Code">8-digit code</label>
                    <input asp-for="Code" inputmode="numeric" autocomplete="one-time-code" maxlength="8"
                           aria-describedby="code-expiry" required />
                    <p id="code-expiry" class="field-help"
                       data-expires="@(verification.ExpiresAt is { } expiresAt ? DateTime.SpecifyKind(expiresAt, DateTimeKind.Utc).ToString("O") : "")">
                        The code expires 10 minutes after you request it.
                    </p>
                </div>
                <div class="login-field">
                    <label asp-for="NewPassword"></label>
                    <input asp-for="NewPassword" autocomplete="new-password" aria-describedby="set-password-error" required />
                    <span asp-validation-for="NewPassword" id="set-password-error" class="login-error" role="alert"></span>
                </div>
                <div class="login-field">
                    <label asp-for="ConfirmPassword"></label>
                    <input asp-for="ConfirmPassword" autocomplete="new-password" aria-describedby="confirm-password-error" required />
                    <span asp-validation-for="ConfirmPassword" id="confirm-password-error" class="login-error" role="alert"></span>
                </div>
                <button id="verify-code-button" class="btn-save-custom login-submit" type="submit">Set password</button>
            </form>
        }

        <form asp-action="SendPasswordSetupCode" method="post" class="@(verification.HasActiveCode ? "auth-alternative" : null)">
            <button class="@(verification.HasActiveCode ? "btn-cancel-custom" : "btn-save-custom") login-submit" type="submit"
                    disabled="@(verification.ResendAfterSeconds > 0)" data-cooldown="@verification.ResendAfterSeconds"
                    data-ready-label="@sendLabel">
                @(verification.ResendAfterSeconds > 0 ? $"Request code in {verification.ResendAfterSeconds}s" : sendLabel)
            </button>
        </form>

        <p class="account-switch"><a asp-action="Settings">Back to account settings</a></p>
    </div>
</section>

@section Scripts {
    <script src="~/js/university-verification.js" asp-append-version="true"></script>
}
