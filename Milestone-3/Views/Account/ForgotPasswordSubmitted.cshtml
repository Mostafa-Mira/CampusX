@{
    ViewData["Title"] = "Password recovery";
}

<section class="login-panel" aria-labelledby="recovery-submitted-title">
    <div class="login-card">
        <h1 id="recovery-submitted-title">Check your inbox</h1>
        <p>If this account is eligible, we’ll send a reset link to its registered login email.</p>
        <p>Check your spam folder. If we also send a code to your verified university email, enter it on the page opened from the reset link.</p>
        <a asp-action="Login" class="btn-save-custom auth-return-link">Back to login</a>
    </div>
</section>
