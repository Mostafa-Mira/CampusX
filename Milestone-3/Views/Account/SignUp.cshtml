@model CampusX.ViewModel.SignUpViewModel

@{
    ViewData["Title"] = "Sign Up";
}

<section class="login-panel" aria-labelledby="signup-title">
    <div class="login-card">
        <span class="section-eyebrow">CAMPUSX ACCOUNT</span>
        <h1 id="signup-title">Create your account</h1>
        <p>Use an approved university email address to join CampusX.</p>
        <p class="signup-note">Development notice: university email ownership is not verified yet.</p>

        <form asp-action="SignUp" method="post">
            <div asp-validation-summary="ModelOnly" class="login-error" role="alert"></div>
            <div class="login-field">
                <label asp-for="FullName"></label>
                <input asp-for="FullName" autocomplete="name" />
                <span asp-validation-for="FullName" class="login-error"></span>
            </div>
            <div class="login-field">
                <label asp-for="Email"></label>
                <input asp-for="Email" autocomplete="email" />
                <span asp-validation-for="Email" class="login-error"></span>
            </div>
            <div class="login-field">
                <label asp-for="Password"></label>
                <input asp-for="Password" autocomplete="new-password" />
                <span asp-validation-for="Password" class="login-error"></span>
            </div>
            <div class="login-field">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="login-error"></span>
            </div>
            <button class="btn-save-custom login-submit" type="submit">Create account</button>
        </form>
        <p class="account-switch">Already have an account? <a asp-action="Login">Log in</a></p>
    </div>
</section>
