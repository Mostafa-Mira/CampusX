@model CampusX.ViewModel.SignUpViewModel

@{
    ViewData["Title"] = "Create account";
}

<section class="login-panel" aria-labelledby="signup-title">
    <div class="login-card registration-card">
        <h1 id="signup-title">Create your account</h1>
        <p>Register, then verify your university email to access the marketplace.</p>
        <partial name="_GoogleSignIn" model="@((string?)null)" />

        <form asp-action="SignUp" method="post">
            <div asp-validation-summary="ModelOnly" class="login-error validation-summary" role="alert"></div>
            <div class="login-field">
                <label asp-for="FullName"></label>
                <input asp-for="FullName" autocomplete="name" aria-describedby="signup-name-error" required />
                <span asp-validation-for="FullName" id="signup-name-error" class="login-error" role="alert"></span>
            </div>
            <div class="login-field">
                <label asp-for="Email"></label>
                <input asp-for="Email" autocomplete="username" autocapitalize="none" spellcheck="false" aria-describedby="login-email-help signup-email-error" required />
                <small id="login-email-help" class="field-help">A personal or university email. You will use this to log in.</small>
                <span asp-validation-for="Email" id="signup-email-error" class="login-error" role="alert"></span>
            </div>
            <div class="form-row">
                <div class="login-field">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" autocomplete="new-password" aria-describedby="signup-password-error" required />
                    <span asp-validation-for="Password" id="signup-password-error" class="login-error" role="alert"></span>
                </div>
                <div class="login-field">
                    <label asp-for="ConfirmPassword"></label>
                    <input asp-for="ConfirmPassword" autocomplete="new-password" aria-describedby="signup-confirm-error" required />
                    <span asp-validation-for="ConfirmPassword" id="signup-confirm-error" class="login-error" role="alert"></span>
                </div>
            </div>
            <fieldset class="university-fields">
                <legend>Your university</legend>
                <div class="login-field">
                    <label asp-for="University"></label>
                    <select asp-for="University" aria-describedby="signup-university-error" required>
                        <option value="">Select your university</option>
                        @foreach (var university in CampusX.Models.StudentUniversities.Names)
                        {
                            <option value="@university" disabled="@(university != CampusX.Models.StudentUniversities.Cairo)">@(university == CampusX.Models.StudentUniversities.Cairo ? university : university + " — Coming Soon")</option>
                        }
                    </select>
                    <span asp-validation-for="University" id="signup-university-error" class="login-error" role="alert"></span>
                </div>
                <div class="login-field">
                    <label asp-for="UniversityEmail"></label>
                    <input asp-for="UniversityEmail" autocomplete="section-university email" autocapitalize="none" spellcheck="false" aria-describedby="university-email-help signup-university-email-error" required />
                    <small id="university-email-help" class="field-help">For Cairo undergraduates, enter your 14-digit student code followed by @@stud.cu.edu.eg. You can use the same address to log in.</small>
                    <span asp-validation-for="UniversityEmail" id="signup-university-email-error" class="login-error" role="alert"></span>
                </div>
            </fieldset>
            <button class="btn-save-custom login-submit" type="submit">Create account</button>
        </form>
        <p class="account-switch">Already have an account? <a asp-action="Login">Log in</a></p>
    </div>
</section>
