@model CampusX.ViewModel.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<section class="login-panel" aria-labelledby="login-title">
    <div class="login-card">
        <h1 id="login-title">Welcome back</h1>
        <p>Use your registered login email to sign in.</p>

        @if (TempData["AccountMessage"] is string accountMessage)
        {
            <p class="account-success" role="status">@accountMessage</p>
        }

        @if (TempData["GoogleError"] is string googleError)
        {
            <p class="login-error validation-summary-errors" role="alert">@googleError</p>
        }
        <div asp-validation-summary="ModelOnly" class="login-error validation-summary" role="alert"></div>
        <form asp-action="Login" method="post">
            <input asp-for="ReturnUrl" type="hidden" />

            <div class="login-field">
                <label asp-for="Email">Login email</label>
                <input asp-for="Email" autocomplete="username" autocapitalize="none" spellcheck="false" aria-describedby="login-email-error" required />
                <span asp-validation-for="Email" id="login-email-error" class="login-error" role="alert"></span>
            </div>
            <div class="login-field">
                <label asp-for="Password">Password</label>
                <input asp-for="Password" autocomplete="current-password" aria-describedby="login-password-error" required />
                <span asp-validation-for="Password" id="login-password-error" class="login-error" role="alert"></span>
            </div>
            <div class="login-recovery"><a asp-action="ForgotPassword">Forgot password?</a></div>
            <button class="btn-save-custom login-submit" type="submit">Log in</button>
        </form>
        <partial name="_GoogleSignIn" model="Model.ReturnUrl" />
        <p class="account-switch">New to CampusX? <a asp-action="SignUp">Create an account</a></p>
    </div>
</section>
