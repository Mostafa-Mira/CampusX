@model CampusX.ViewModel.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
}

<section class="login-panel" aria-labelledby="forgot-title">
    <div class="login-card">
        <h1 id="forgot-title">Forgot your password?</h1>
        <p>Enter the login email registered to your CampusX account.</p>
        <form asp-action="ForgotPassword" method="post">
            <div class="login-field">
                <label asp-for="Email"></label>
                <input asp-for="Email" autocomplete="email" autocapitalize="none" spellcheck="false"
                       aria-describedby="forgot-email-error" required />
                <span asp-validation-for="Email" id="forgot-email-error" class="login-error" role="alert"></span>
            </div>
            <button class="btn-save-custom login-submit" type="submit">Send reset link</button>
        </form>
        <p class="account-switch"><a asp-action="Login">Back to login</a></p>
    </div>
</section>
