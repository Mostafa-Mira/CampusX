@model CampusX.ViewModel.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
}

<section class="login-panel" aria-labelledby="reset-title">
    <div class="login-card">
        <h1 id="reset-title">Set a new password</h1>
        <p>Choose a new password for your CampusX account.</p>
        <p class="verification-notice" data-reset-missing role="status" hidden>Open the reset link from your email to continue.</p>
        <noscript><p class="verification-notice">Enable JavaScript, then open your reset link again.</p></noscript>
        <div asp-validation-summary="ModelOnly" class="login-error validation-summary" role="alert"></div>
        <form asp-action="ResetPassword" method="post" data-reset-form hidden>
            <input asp-for="Ticket" type="hidden" />
            <input asp-for="NeedsUniversityCode" type="hidden" />
            <div class="login-field" data-reset-university hidden>
                <label for="UniversityCode">University confirmation code</label>
                <input id="UniversityCode" name="UniversityCode" type="text" autocomplete="one-time-code"
                       autocapitalize="characters" spellcheck="false" maxlength="32" aria-describedby="reset-code-help reset-code-error" />
                <small class="field-help" id="reset-code-help">Use the code from the separate message sent to your verified university inbox.</small>
                <span asp-validation-for="UniversityCode" id="reset-code-error" class="login-error" role="alert"></span>
            </div>
            <div class="login-field">
                <label asp-for="Password"></label>
                <input asp-for="Password" autocomplete="new-password" maxlength="256" aria-describedby="reset-password-error" required />
                <span asp-validation-for="Password" id="reset-password-error" class="login-error" role="alert"></span>
            </div>
            <div class="login-field">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" autocomplete="new-password" maxlength="256" aria-describedby="reset-confirm-error" required />
                <span asp-validation-for="ConfirmPassword" id="reset-confirm-error" class="login-error" role="alert"></span>
            </div>
            <button class="btn-save-custom login-submit" type="submit">Reset password</button>
        </form>
        <p class="account-switch"><a asp-action="ForgotPassword">Request a new reset link</a> <span aria-hidden="true">·</span> <a asp-action="Login">Back to login</a></p>
    </div>
</section>

@section Scripts {
    <script src="~/js/password-recovery.js" asp-append-version="true"></script>
}
