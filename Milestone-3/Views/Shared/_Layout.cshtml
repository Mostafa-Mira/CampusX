@inject CampusX.Models.CategoryBL LayoutCategoryBL
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CampusX</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="topbar" aria-label="Main navigation">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="CampusX home">
                <span class="brand-mark" aria-hidden="true">X</span>
                <span class="brand-name">Campus<span>X</span><small>STUDENT MARKETPLACE</small></span>
            </a>

            <form id="search-form" class="search-form" asp-controller="Home" asp-action="Index" method="get" role="search">
                <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></svg>
                <label class="visually-hidden" for="site-search">Search products</label>
                <input id="site-search" type="search" name="searchTerm" value="@Context.Request.Query["searchTerm"]" placeholder="Search for books, tech, and more..." />
                <button type="submit">Search</button>
            </form>

            <div class="header-actions" aria-label="Account features coming soon">
                <span class="header-icon" aria-label="Notifications coming soon" title="Notifications coming soon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9Z" /><path d="M10 21h4" /></svg>
                </span>
                <span class="profile-placeholder" aria-label="Profile coming soon" title="Profile coming soon">
                    <span class="profile-avatar" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="3.5" /><path d="M5.5 20c.6-3.3 3-5 6.5-5s5.9 1.7 6.5 5" /></svg></span>
                    <span class="profile-label">Profile <small>Coming soon</small></span>
                </span>
            </div>
        </nav>
    </header>

    <div class="page-shell">
        <aside class="sidebar" aria-label="Explore CampusX">
            <div class="sidebar-panel">
                <input class="sidebar-check" type="checkbox" id="sidebar-check" aria-label="Show navigation and filters" />
                <label class="sidebar-toggle" for="sidebar-check">Explore &amp; filters <span aria-hidden="true">⌄</span></label>
                <div class="sidebar-inner">
                    <div class="sidebar-section-label">NAVIGATION</div>
                    <nav aria-label="Product navigation">
                        <ul class="sidebar-nav">
                            <li><a class="sidebar-link" asp-controller="Home" asp-action="Index"><span class="nav-icon" aria-hidden="true">▦</span> Browse Products</a></li>
                            <li><span class="sidebar-link is-disabled"><span class="nav-icon" aria-hidden="true">▤</span> My Products <small>Soon</small></span></li>
                            <li><a class="sidebar-link" asp-controller="Products" asp-action="Add"><span class="nav-icon" aria-hidden="true">＋</span> Add Product</a></li>
                            <li><span class="sidebar-link is-disabled"><span class="nav-icon" aria-hidden="true">♡</span> Favorites <small>Soon</small></span></li>
                        </ul>
                    </nav>

                    <div class="sidebar-divider"></div>
                    <div class="filter-heading"><span class="sidebar-section-label">FILTERS</span></div>
                    <div class="filter-group" aria-label="Product filters">
                        <div class="filter-item">
                            <label class="filter-label" for="filter-category">Categories</label>
                            <select id="filter-category" class="filter-control" name="categoryId" form="search-form">
                                <option value="">All categories</option>
                                @foreach (var cat in LayoutCategoryBL.GetAll())
                                {
                                    <option value="@cat.Id" selected="@(Context.Request.Query["categoryId"] == cat.Id.ToString())">@cat.Name</option>
                                }
                            </select>
                        </div>
                        <div class="filter-item"><span class="filter-label">University</span><span class="filter-display">Any university <span aria-hidden="true">⌄</span></span></div>
                        <div class="filter-item">
                            <span class="filter-label">Price Range (EGP)</span>
                            <div class="price-range">
                                <input type="number" class="filter-control" name="minPrice" form="search-form" min="0" placeholder="Min" value="@Context.Request.Query["minPrice"]" aria-label="Minimum price" />
                                <input type="number" class="filter-control" name="maxPrice" form="search-form" min="0" placeholder="Max" value="@Context.Request.Query["maxPrice"]" aria-label="Maximum price" />
                            </div>
                        </div>
                        <div class="filter-item"><span class="filter-label">Product Condition</span><span class="filter-display">Any condition <span aria-hidden="true">⌄</span></span></div>
                        <button type="submit" form="search-form" class="filter-apply">Apply filters</button>
                        <a class="filter-clear" asp-controller="Home" asp-action="Index">Clear all</a>
                    </div>
                    <div class="sidebar-note"><span aria-hidden="true">✦</span><span>Find what you need, right here on campus.</span></div>
                </div>
            </div>
        </aside>

        <main class="main-content" role="main">@RenderBody()</main>
    </div>

    <footer class="site-footer"><span>© @DateTime.Now.Year CampusX</span><span>Made for campus life</span></footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

