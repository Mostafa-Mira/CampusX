@model CampusX.ViewModel.AddProductViewModel
@{
    ViewData["Title"] = "Edit Product";
}
<section class="add-product-card" aria-labelledby="product-form-title">
    <span class="section-eyebrow">YOUR CAMPUS LISTING</span>
    <h1 id="product-form-title">Edit Product</h1>
    <p class="form-intro">Give your listing a refresh. Update its details below.</p>

    <form asp-action="Edit" asp-route-id="@ViewBag.ProductId" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="validation-summary login-error" role="alert"></div>
        <div class="form-row">
            <div class="form-field">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control-custom" placeholder="e.g. Data Structures Textbook" />
                <span asp-validation-for="Name"></span>
            </div>
            <div class="form-field">
                <label asp-for="Price">Price (EGP)</label>
                <input asp-for="Price" class="form-control-custom" placeholder="0.00 EGP" />
                <span asp-validation-for="Price"></span>
            </div>
        </div>
        <div class="form-row">
            <div class="form-field">
                <label asp-for="College">College (Optional)</label>
                <select asp-for="College" id="collegeSelect" class="form-control-custom">
                    <option value="">Select College (Optional)...</option>
                    <option value="Medicine">Medicine (طب بشري)</option>
                    <option value="Dentistry">Dentistry (طب أسنان)</option>
                    <option value="Pharmacy">Pharmacy (صيدلة)</option>
                    <option value="Engineering">Engineering (هندسة)</option>
                    <option value="Science">Science (علوم)</option>
                </select>
                <span asp-validation-for="College"></span>
            </div>
            <div class="form-field">
                <label asp-for="Category"></label>
                <select asp-for="Category" id="categorySelect" class="form-control-custom">
                    <option value="">-- Select Category --</option>
                </select>
                <span asp-validation-for="Category"></span>
            </div>
        </div>
        <div class="form-field">
            <label asp-for="PhoneNumber">Contact Phone Number</label>
            <input asp-for="PhoneNumber" class="form-control-custom" placeholder="e.g. 01012345678 (010, 011, 012, 015)" />
            <span asp-validation-for="PhoneNumber"></span>
        </div>
        <div class="form-field">
            <label asp-for="ImageFile"></label>
            <input asp-for="ImageFile" id="customFile" class="form-control-custom" type="file" accept=".jpg,.jpeg,.png,.webp,.gif,image/jpeg,image/png,image/webp,image/gif" aria-describedby="image-help" />
            <small class="field-help" id="image-help">JPG, PNG, WEBP or GIF, up to 5 MB. Leave blank to keep the existing image.</small>
            <span asp-validation-for="ImageFile"></span>
        </div>
        <div class="form-field">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" id="productDescription" class="form-control-custom" rows="4" maxlength="300" placeholder="Describe the condition, edition, or details (max 300 characters)..."></textarea>
            <div class="description-meta">
                <span asp-validation-for="Description"></span>
                <small id="charCount">0 / 300 characters</small>
            </div>
        </div>
        <div class="form-actions">
            <a asp-controller="Home" asp-action="Details" asp-route-id="@ViewBag.ProductId" class="btn-cancel-custom">Cancel</a>
            <button type="submit" class="btn-save-custom">Save Changes</button>
        </div>
    </form>
</section>

@section Scripts {
    <script>
        const categoriesByCollege = {
            "Medicine": ["Medical Books", "Stethoscope", "Surgical Kit", "Lab Coat", "Anatomy Models"],
            "Dentistry": ["Dental Instruments", "Dental Textbooks", "Typodont", "Dental Mirror & Explorer"],
            "Pharmacy": ["Pharmacy Books", "Lab Equipment", "White Coat", "Pharmacology Guides"],
            "Engineering": ["Engineering Kit", "Calculators", "Drawing Tools & Board", "Laptop / Tech Gear", "Textbooks"],
            "Science": ["Scientific Calculator", "Lab Coat & Safety Glasses", "Science Textbooks", "Dissection Kit"]
        };

        const collegeSelect = document.getElementById("collegeSelect");
        const categorySelect = document.getElementById("categorySelect");
        const preselectedCategory = "@Model?.Category";

        function updateCategories() {
            const selectedCollege = collegeSelect.value;
            categorySelect.innerHTML = '<option value="">-- Select Category --</option>';

            let availableCategories = [];
            if (selectedCollege && categoriesByCollege[selectedCollege]) {
                availableCategories = categoriesByCollege[selectedCollege];
            } else {
                let allCatsSet = new Set();
                for (let college in categoriesByCollege) {
                    categoriesByCollege[college].forEach(cat => allCatsSet.add(cat));
                }
                availableCategories = Array.from(allCatsSet);
            }

            availableCategories.forEach(category => {
                const option = document.createElement("option");
                option.value = category;
                option.textContent = category;
                if (category === preselectedCategory) {
                    option.selected = true;
                }
                categorySelect.appendChild(option);
            });
        }

        updateCategories();
        collegeSelect.addEventListener("change", updateCategories);

        const descInput = document.getElementById("productDescription");
        const charCount = document.getElementById("charCount");

        function updateCharCount() {
            const currentLength = descInput.value.length;
            charCount.textContent = currentLength + " / 300 characters";
        }

        descInput.addEventListener("input", updateCharCount);
        updateCharCount();
    </script>
}
