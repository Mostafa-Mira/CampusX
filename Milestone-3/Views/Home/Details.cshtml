@model CampusX.ViewModels.ProductDetailsViewModel
@using CampusX.Enums

@{
    ViewData["Title"] = Model.Name;
    var removalLabel = Model.CanModerate ? "Remove listing" : "Delete product";
}

<section class="product-details" aria-labelledby="product-title">

  
    <div style="margin-bottom: 20px;">
        <a class="back-to-products" asp-action="Index"><span aria-hidden="true">←</span> Back to Products</a>
    </div>
 

    <div class="product-details-card">
        <div class="product-details-media">
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Name" onerror="this.hidden=true; this.nextElementSibling.hidden=false;" />
                <div class="product-details-placeholder" hidden role="img" aria-label="No image available for @Model.Name"><span aria-hidden="true">▦</span><span>No image available</span></div>
            }
            else
            {
                <div class="product-details-placeholder" role="img" aria-label="No image available for @Model.Name"><span aria-hidden="true">▦</span><span>No image available</span></div>
            }
        </div>

        <div class="product-details-content">
            @if (TempData["ProductSuccess"] is string success)
            {
                <p class="account-success" role="status">@success</p>
            }
            @if (TempData["ProductError"] is string error)
            {
                <p class="validation-summary-errors" role="alert">@error</p>
            }
            <div class="details-label-row"><span class="product-category">@Model.CategoryName</span><span class="product-status">@Model.Status</span></div>
            <h1 id="product-title">@Model.Name</h1>
            <p class="product-id">Listing ID: @Model.Id</p>
            <p class="details-price">@Model.Price.ToString("N2") <span>EGP</span></p>

            <div class="details-section"><h2>Description</h2><p class="details-description">@Model.Description</p></div>

            @if (!string.IsNullOrWhiteSpace(Model.College) || !string.IsNullOrWhiteSpace(Model.PhoneNumber))
            {
                <div class="details-section product-details-info">
                    <h2>Listing details</h2>
                    <dl>
                        @if (!string.IsNullOrWhiteSpace(Model.College))
                        {
                            <div><dt>College</dt><dd>@Model.College</dd></div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.PhoneNumber))
                        {
                            <div><dt>Contact phone</dt><dd><a href="tel:@Model.PhoneNumber">@Model.PhoneNumber</a></dd></div>
                        }
                    </dl>
                </div>
            }

            <div class="seller-details">
                <div class="seller-details-heading">
                    <span class="seller-details-avatar" aria-hidden="true">@(string.IsNullOrWhiteSpace(Model.SellerName) ? "?" : Model.SellerName[..1].ToUpperInvariant())</span>
                    <div>
                        <span>Listed by</span>
                        <h2>@Model.SellerName</h2>
                        @if (!string.IsNullOrWhiteSpace(Model.SellerCollegeName))
                        {
                            <p class="seller-university">@Model.SellerCollegeName</p>
                        }
                    </div>
                </div>
                <dl class="seller-contact-list">
                    @if (!string.IsNullOrWhiteSpace(Model.SellerEmail))
                    {
                        <div><dt>Email</dt><dd><a href="mailto:@Model.SellerEmail">@Model.SellerEmail</a></dd></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.SellerPhoneNumber))
                    {
                        <div><dt>Phone</dt><dd><a href="tel:@Model.SellerPhoneNumber">@Model.SellerPhoneNumber</a></dd></div>
                    }
                    @if (string.IsNullOrWhiteSpace(Model.SellerEmail) && string.IsNullOrWhiteSpace(Model.SellerPhoneNumber))
                    {
                        <div><dt>Contact</dt><dd>Contact details are not available.</dd></div>
                    }
                </dl>
            </div>

            @if (Model.CanEdit || Model.CanRemove)
            {
                <div class="product-details-actions">
                    @if (Model.CanEdit)
                    {
                        <a asp-controller="Products" asp-action="Edit" asp-route-id="@Model.Id" class="product-detail-action product-detail-edit">Edit Product</a>
                    }
                    @if (Model.CanEdit && Model.Status == ProductStatus.Available)
                    {
                        <form asp-controller="MyProducts" asp-action="MarkSold" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Mark this product as sold? It will be hidden from the marketplace.');">
                            <button type="submit" class="product-detail-action product-detail-edit">Mark as Sold</button>
                        </form>
                    }
                    @if (Model.CanRemove)
                    {
                        <button type="button" class="product-detail-action product-detail-delete" onclick="document.getElementById('delete-product-@Model.Id').showModal()">@removalLabel</button>
                    }
                </div>
            }

            @if (Model.CanRemove)
            {
                <dialog class="sample-delete-dialog" id="delete-product-@Model.Id" aria-labelledby="delete-title-@Model.Id" aria-describedby="delete-name-@Model.Id delete-message-@Model.Id" dir="ltr">
                    <div class="sample-delete-dialog-body">
                        <span class="sample-delete-icon" aria-hidden="true">!</span>
                        <h2 id="delete-title-@Model.Id">@removalLabel?</h2>
                        <p class="sample-delete-product-name" id="delete-name-@Model.Id">@Model.Name</p>
                        <p id="delete-message-@Model.Id">@(Model.CanModerate ? "This listing will be hidden from the marketplace." : "This product cannot be restored after deletion.")</p>
                        <form asp-controller="ProductsDelete" asp-action="@(Model.CanModerate ? "Remove" : "Delete")" asp-route-id="@Model.Id" method="post" class="sample-delete-actions">
                            <button type="button" class="sample-delete-cancel" autofocus onclick="document.getElementById('delete-product-@Model.Id').close()">Cancel</button>
                            <button type="submit" class="sample-delete-confirm">@removalLabel</button>
                        </form>
                    </div>
                </dialog>
            }

        </div>
    </div>
</section>
