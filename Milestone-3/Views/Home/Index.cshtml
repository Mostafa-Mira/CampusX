@model CampusX.ViewModels.HomeIndexViewModel

@{
    ViewData["Title"] = Model.Heading;
}

<section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
        <span class="hero-eyebrow"><span aria-hidden="true">✦</span> THE CAMPUS MARKETPLACE</span>
        <h1 id="hero-title">Discover Campus Deals</h1>
        <p>Buy and sell study essentials with students like you.</p>
    </div>
    <div class="hero-art" aria-hidden="true">
        <div class="hero-halo"></div>
        <div class="campus-building">
            <div class="building-roof"></div>
            <div class="building-facade"><span></span><span></span><span></span><span></span><span></span></div>
            <div class="building-steps"></div>
        </div>
    </div>
</section>

<section class="catalog" aria-labelledby="catalog-title">
    @if (TempData["SampleProductMessage"] is string sampleMessage)
    {
        <p role="status">@sampleMessage</p>
    }
    <div class="catalog-heading">
        <div>
            <span class="section-eyebrow">EXPLORE CAMPUSX</span>
            <h2 id="catalog-title">@Model.Heading</h2>
            <p>@Model.Description</p>
        </div>
        <span class="product-count">@Model.Products.Count Available Products</span>
    </div>

    <div class="catalog-controls">
        <!-- تم تحويل التابات إلى أزرار تفاعلية تعمل بالـ JavaScript -->
        <div class="category-chips" aria-label="Category filters">
            <a class="category-chip @(Model.CategoryId == null ? "is-active" : "")"
               asp-controller="Home" asp-action="Index"
               asp-route-searchTerm="@Model.SearchTerm"
               asp-route-minPrice="@Model.MinPrice"
               asp-route-maxPrice="@Model.MaxPrice"
               asp-route-sortBy="@Model.SortBy">All products</a>
            @foreach (var category in Model.Categories)
            {
                <a class="category-chip @(Model.CategoryId == category.Id ? "is-active" : "")"
                   asp-controller="Home" asp-action="Index"
                   asp-route-categoryId="@category.Id"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-minPrice="@Model.MinPrice"
                   asp-route-maxPrice="@Model.MaxPrice"
                   asp-route-sortBy="@Model.SortBy">@category.Name</a>
            }
        </div>
        <label class="sort-select">
            Sort by
            <select name="sortBy" form="search-form" onchange="this.form.submit()">
                <option value="newest" selected="@(Model.SortBy == "newest")">Newest</option>
                <option value="price_asc" selected="@(Model.SortBy == "price_asc")">Price: Low to High</option>
                <option value="price_desc" selected="@(Model.SortBy == "price_desc")">Price: High to Low</option>
            </select>
        </label>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="empty-state" role="alert">
            <h3>@Model.ErrorMessage</h3>
        </div>
    }

    @if (Model.Products.Count == 0)
    {
        <div class="empty-state" role="status">
            <div class="empty-icon" aria-hidden="true">▦</div>
            <h3>No products available yet</h3>
            <p>Check back soon for new listings from students on campus.</p>
        </div>
    }
    else
    {
        <div class="product-grid">
            @foreach (var product in Model.Products)
            {
                <partial name="_ProductCard" model="product" />
            }
        </div>
    }
</section>

<!-- كود JavaScript لتفعيل تابات الفلترة أوتوماتيكياً -->
<script type="text/javascript">
    document.addEventListener("DOMContentLoaded", function () {
        var chips = document.querySelectorAll(".category-chip");
        var cards = document.querySelectorAll(".product-card");

        chips.forEach(function (chip) {
            chip.addEventListener("click", function () {
                chips.forEach(function (c) { c.classList.remove("is-active"); });
                this.classList.add("is-active");

                var target = this.getAttribute("data-category");

                cards.forEach(function (card) {
                    var catEl = card.querySelector(".product-category");
                    var catText = catEl ? catEl.textContent.trim() : "";

                    if (target === "all" || catText === target) {
                        card.style.display = "block";
                    } else {
                        card.style.display = "none";
                    }
                });
            });
        });
    });
</script>